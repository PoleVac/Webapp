@page "/"
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Linq
@using System.Collections.Generic
@inject IJSRuntime JS

<PageTitle>Registro de gastos</PageTitle>

<header class="login-header">
    <div style="
        FLEX: auto;
        ">
        <h1 class="text-white">Registro de gastos</h1>
    </div>
    <div id="google-button" class="login-action"></div>

    <button id="logout-button" class="logout-button" style="display:none" @onclick="CerrarSesion">
        Cerrar sesión
    </button>
</header>

<main class="home-content">
    <div class="text-white">

        <p>Inicia sesión para consultar y registrar gastos.</p>

        <p id="login-status" role="status">
            Esperando inicio de sesión...
        </p>
    </div>
    

    <div id="gastos-panel" style="display:none">

        <section class="expense-card">
            <h2>Registrar gasto</h2>

            <form @onsubmit="GuardarGasto" @onsubmit:preventDefault>
                <div class="form-grid">

                    <div class="form-field">
                        <label for="fecha">Fecha</label>
                        <input id="fecha" type="date" @bind="nuevoGasto.Fecha" required />
                    </div>

                    <div class="form-field">
                        <label for="descripcion">Descripción</label>
                        <input id="descripcion" @bind="nuevoGasto.Descripcion" maxlength="200"
                               placeholder="Ej. Compra del supermercado" required />
                    </div>

                    
                    <div class="form-field">
                        <label>Categoría</label>

                        <div class="categoria-selector">
                            <button type="button" class="categoria-seleccionada"
                                    @onclick="() => mostrarCategorias = !mostrarCategorias">
                                @if (CategoriaActual is not null)
                                {
                                    @if (!string.IsNullOrWhiteSpace(CategoriaActual.Logo))
                                    {
                                        <img src="@CategoriaActual.Logo" alt="" class="categoria-logo" />
                                    }

                                    <span>@CategoriaActual.Nombre</span>
                                }
                                else
                                {
                                    <span>Seleccionar categoría</span>
                                }

                                <span class="categoria-flecha">⌄</span>
                            </button>

                            @if (mostrarCategorias)
                            {
                                <div class="categoria-opciones">
                                    @foreach (var categoria in Categorias)
                                    {
                                        <button type="button" class="categoria-opcion"
                                                @onclick="() => SeleccionarCategoria(categoria)">
                                            @if (!string.IsNullOrWhiteSpace(categoria.Logo))
                                            {
                                                <img src="@categoria.Logo" alt="" class="categoria-logo" />
                                            }

                                            <span>@categoria.Nombre</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="importe">Importe (S/)</label>
                        <input id="importe" type="number" @bind="nuevoGasto.Importe" min="0.01" step="0.01" required />
                    </div>

                    <div class="form-field">
                        <label for="pagado-por">Pagado por</label>
                        <select id="pagado-por" @bind="nuevoGasto.PagadoPor" required>
                            <option value="" disabled selected hidden>Selecciona quién pagó</option>
                            <option>Alejandro</option>
                            <option>Dayanna</option>
                        </select>
                    </div>

                    <div class="form-field">
                        <label for="tipo">Tipo</label>
                        <select id="tipo" @bind="nuevoGasto.Tipo" required>
                            <option value="Compartido">Compartido</option>
                            <option value="Personal" selected>Personal</option>
                        </select>
                    </div>

                </div>

                <button type="submit" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar gasto")
                </button>
            </form>
        </section>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <p role="status" class="status-message">@mensaje</p>
        }

        <section class="expense-card">
            <div class="table-heading">
                <h2>Gastos registrados</h2>
                <button type="button" @onclick="CargarGastos" disabled="@cargando">
                    @(cargando ? "Cargando..." : "Actualizar")
                </button>
            </div>

            @if (cargando)
            {
                <p>Cargando gastos...</p>
            }
            else if (gastos.Count == 0)
            {
                <p>Aún no hay gastos para mostrar. Pulsa Actualizar.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Descripción</th>
                                <th>Categoría</th>
                                <th>Importe</th>
                                <th>Pagado por</th>
                                <th>Tipo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var gasto in gastos)
                            {
                                <tr @key="gasto.Id">
                                    <td>@gasto.Fecha</td>
                                    <td>@gasto.Descripcion</td>
                                    <td>@gasto.Categoria</td>
                                    <td>S/ @gasto.Importe.ToString("N2")</td>
                                    <td>@gasto.PagadoPor</td>
                                    <td>@gasto.Tipo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</main>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("gastosGoogle.inicializar");
        }
    }

    private Gasto nuevoGasto = new()
    {
        Fecha = DateTime.Today,
        Tipo = "Compartido"
    };

    private List<Gasto> gastos = new();
    private bool guardando;
    private bool cargando;
    private string mensaje = "";

    private async Task GuardarGasto()
    {
        if (guardando)
            return;

        guardando = true;
        mensaje = "";

        try
        {
            var datos = new
            {
                fecha = nuevoGasto.Fecha.ToString("yyyy-MM-dd"),
                descripcion = nuevoGasto.Descripcion.Trim(),
                categoria = nuevoGasto.Categoria,
                importe = nuevoGasto.Importe,
                pagado_por = nuevoGasto.PagadoPor.Trim(),
                tipo = nuevoGasto.Tipo
            };

            await JS.InvokeAsync<JsonElement>(
                "gastosApi.agregar", datos);

            mensaje = "Gasto guardado correctamente.";

            nuevoGasto = new Gasto
            {
                Fecha = DateTime.Today,
                Tipo = "Compartido"
            };

            await CargarGastos();
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo guardar el gasto: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CargarGastos()
    {
        if (cargando)
            return;

        cargando = true;
        mensaje = "";

        try
        {
            var respuesta = await JS.InvokeAsync<JsonElement>(
                "gastosApi.listar");

            JsonElement filas = respuesta;

            if (respuesta.ValueKind == JsonValueKind.Object)
            {
                if (respuesta.TryGetProperty("ok", out var ok) &&
                    ok.ValueKind == JsonValueKind.False)
                {
                    throw new Exception("La API rechazó la consulta.");
                }

                bool encontrada =
                    respuesta.TryGetProperty("gastos", out filas) ||
                    respuesta.TryGetProperty("data", out filas) ||
                    respuesta.TryGetProperty("registros", out filas);

                if (!encontrada)
                    throw new Exception(
                        "La respuesta de la API no contiene la lista de gastos.");
            }

            if (filas.ValueKind != JsonValueKind.Array)
                throw new Exception("La lista recibida no es un array.");

            gastos = JsonSerializer.Deserialize<List<Gasto>>(
                filas.GetRawText(),
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new List<Gasto>();
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudieron cargar los gastos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("gastosGoogle.cerrarSesion");
    }

    public class Gasto
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = "";

        [JsonPropertyName("fecha")]
        public DateTime Fecha { get; set; } = DateTime.Today;

        [JsonPropertyName("descripcion")]
        public string Descripcion { get; set; } = "";

        [JsonPropertyName("categoria")]
        public string Categoria { get; set; } = "";

        [JsonPropertyName("importe")]
        public decimal Importe { get; set; }

        [JsonPropertyName("pagado_por")]
        public string PagadoPor { get; set; } = "";

        [JsonPropertyName("tipo")]
        public string Tipo { get; set; } = "";
    }

    
    private bool mostrarCategorias = false;

    private class CategoriaGasto
    {
        public string Nombre { get; set; } = "";
        public string Logo { get; set; } = "";
    }

    private List<CategoriaGasto> Categorias = new()
    {
        new() { Nombre = "Ropa" },
        new() { Nombre = "Restaurantes/Delivery" },
        new() { Nombre = "Alimentación por conveniencia" },
        new() { Nombre = "Alimentación mensual" },
        new() { Nombre = "Transporte público" },
        new() { Nombre = "Compras variadas" },
        new() { Nombre = "Legos", Logo = "images/LEGO_logo.svg" },
        new() { Nombre = "Mini" },
        new() { Nombre = "Juegos" },
        new() { Nombre = "Salud" },
        new() { Nombre = "Otros" }
    };



    private CategoriaGasto? CategoriaActual =>
        Categorias.FirstOrDefault(c => c.Nombre == nuevoGasto.Categoria);

    private void SeleccionarCategoria(CategoriaGasto categoria)
    {
        nuevoGasto.Categoria = categoria.Nombre;
        mostrarCategorias = false;
    }

}
